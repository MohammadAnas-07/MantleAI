APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://mantle:mantle@127.0.0.1:5433/mantle
# Required. Fernet key that encrypts provider API keys; the API refuses to start without it.
# Generate one (from backend, venv active) and paste it after the = sign:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing it makes stored provider keys unreadable.
MASTER_ENCRYPTION_KEY=
# Dimension of the pgvector chunks.embedding column. Changing it needs a new migration and a
# re-index of every project.
EMBEDDING_DIMENSIONS=1536
# Project indexing. Indexed code is sent to the embedding model's provider.
# DEFAULT_EMBEDDING_MODEL=gemini/gemini-embedding-001
# INDEX_COST_LIMIT_USD=1.00
# EMBED_BATCH_DELAY_SECONDS=1.0
# INDEX_SENSITIVE_PATTERNS=["private/"]
