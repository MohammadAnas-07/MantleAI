APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://mantle:mantle@127.0.0.1:5433/mantle
# Required for pytest only. The tests use this database and nothing else; its name must end
# in _test. Without it, pytest stops before connecting. Create the database once (Docker running):
#   docker exec mantleai-db-1 psql -U mantle -d postgres -c "CREATE DATABASE mantle_test OWNER mantle;"
TEST_DATABASE_URL=postgresql+asyncpg://mantle:mantle@127.0.0.1:5433/mantle_test
# Required. Fernet key that encrypts provider API keys; the API refuses to start without it.
# Generate one (from backend, venv active) and paste it after the = sign:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing it makes stored provider keys unreadable.
MASTER_ENCRYPTION_KEY=
# Dimension of the pgvector chunks.embedding column. Changing it needs a new migration and a
# re-index of every project.
EMBEDDING_DIMENSIONS=1536
# Project indexing. Indexed code is sent to the embedding model's provider.
# DEFAULT_EMBEDDING_MODEL=gemini/gemini-embedding-001
# INDEX_COST_LIMIT_USD=1.00
# EMBED_BATCH_DELAY_SECONDS=1.0
# Retries of one embedding batch stop once their waits would pass this total (seconds).
# EMBED_RETRY_MAX_TOTAL_WAIT_SECONDS=900
# A rate limit asking for a longer wait than this (or naming a per-day quota) is treated as a
# used-up quota and never retried (seconds).
# LLM_QUOTA_EXHAUSTED_MIN_WAIT_SECONDS=600
# Seconds of silence before a provider call gives up (for a stream: between two parts).
# LLM_TIMEOUT_SECONDS=120
# INDEX_SENSITIVE_PATTERNS=["private/"]
# Agent and gap finder runs. Runs above the cost estimate limit need force=true. A model with no
# price in the catalog is refused (model_not_priced) unless unpriced models are allowed.
# AGENT_RUN_COST_LIMIT_USD=0.50
# AGENT_ALLOW_UNPRICED_MODELS=false
# Browser origins allowed to call the API, and host names the API answers to (JSON lists).
# CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# ALLOWED_HOSTS=["localhost","127.0.0.1"]
# Answer requests from other computers too (403 otherwise). Mantle has no login: leave off.
# ALLOW_REMOTE_CLIENTS=false

# ---- Tuning: the defaults below are what the API uses; uncomment a line to change it.
# Prompt budget and model switching
# CONTEXT_RESERVED_OUTPUT_TOKENS=4096
# CONTEXT_SAFETY_MARGIN=0.1
# CONTEXT_KEEP_RECENT_TURNS=2
# CONVERSATION_LOCK_TIMEOUT_SECONDS=600
# Rolling summary (the only background model call)
# SUMMARY_TRIGGER_TOKENS=2000
# SUMMARY_MAX_OUTPUT_TOKENS=1024
# Project memory and pinned items
# MEMORY_TITLE_MAX_LENGTH=200
# MEMORY_TEXT_MAX_LENGTH=5000
# MEMORY_MAX_ITEMS_PER_KIND=500
# MEMORY_PAGE_MAX=100
# PINNED_MAX_SHARE=0.25
# PINNED_MAX_DECISIONS=30
# PINNED_MAX_REQUIREMENTS=30
# PINNED_MAX_TASKS=30
# PINNED_ITEM_MAX_CHARS=600
# Indexing limits and splitting
# INDEX_MAX_FILE_BYTES=1000000
# INDEX_MAX_FILES=20000
# INDEX_MAX_CHUNKS_PER_FILE=200
# Folder levels walked below the source folder (1-200), and files plus folders one run looks at
# INDEX_MAX_DEPTH=40
# INDEX_MAX_ENTRIES=100000
# A running index run silent this long can be cancelled at once (keep above the retry wait)
# INDEX_RUN_STALE_SECONDS=1800.0
# CHUNK_MAX_CHARS=4000
# CHUNK_MIN_CHARS=200
# CHUNK_WINDOW_LINES=60
# CHUNK_OVERLAP_LINES=5
# Embedding batches and rate-limit backoff
# EMBED_BATCH_MAX_ITEMS=64
# EMBED_BATCH_MAX_TOKENS=16000
# EMBED_RATE_LIMIT_BACKOFF_SECONDS=10.0
# EMBED_RATE_LIMIT_BACKOFF_MAX_SECONDS=120.0
# EMBED_MAX_RETRIES=5
# Retrieval (hybrid search) in chat and agent runs
# RETRIEVAL_TOP_K=8
# RETRIEVAL_MAX_TOP_K=50
# RETRIEVAL_CANDIDATES=50
# RETRIEVAL_QUERY_MAX_CHARS=2000
# RETRIEVAL_RRF_K=60
# RETRIEVED_MAX_SHARE=0.3
# Tokens the project profile may use in a prompt (its least important fields go first)
# CONTEXT_PROFILE_MAX_TOKENS=600
# Workflow and agent runs
# WORKFLOW_REASON_MAX_LENGTH=500
# AGENT_MAX_INPUT_TOKENS=60000
# AGENT_MAX_OUTPUT_TOKENS=4000
# AGENT_STEP_TIMEOUT_SECONDS=180.0
# AGENT_RUN_STALE_SECONDS=900.0
# AGENT_MEMORY_MAX_SHARE=0.5
# AGENT_REQUIREMENT_MAX_CHARS=4000
# AGENT_PLAN_MAX_ITEMS=30
# AGENT_CODE_CONTEXT_MAX_BLOCKS=6
