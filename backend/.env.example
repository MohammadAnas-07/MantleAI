APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://mantle:mantle@127.0.0.1:5433/mantle
# Required for pytest only. The tests use this database and nothing else; its name must end
# in _test. Without it, pytest stops before connecting. Create the database once (Docker running):
#   docker exec mantleai-db-1 psql -U mantle -d postgres -c "CREATE DATABASE mantle_test OWNER mantle;"
TEST_DATABASE_URL=postgresql+asyncpg://mantle:mantle@127.0.0.1:5433/mantle_test
# Required. Fernet key that encrypts provider API keys; the API refuses to start without it.
# Generate one (from backend, venv active) and paste it after the = sign:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing it makes stored provider keys unreadable.
MASTER_ENCRYPTION_KEY=
# Dimension of the pgvector chunks.embedding column. Changing it needs a new migration and a
# re-index of every project.
EMBEDDING_DIMENSIONS=1536
# Project indexing. Indexed code is sent to the embedding model's provider.
# DEFAULT_EMBEDDING_MODEL=gemini/gemini-embedding-001
# INDEX_COST_LIMIT_USD=1.00
# EMBED_BATCH_DELAY_SECONDS=1.0
# Retries of one embedding batch stop once their waits would pass this total (seconds).
# EMBED_RETRY_MAX_TOTAL_WAIT_SECONDS=900
# A rate limit asking for a longer wait than this (or naming a per-day quota) is treated as a
# used-up quota and never retried (seconds).
# LLM_QUOTA_EXHAUSTED_MIN_WAIT_SECONDS=600
# INDEX_SENSITIVE_PATTERNS=["private/"]
# Agent and gap finder runs. Runs above the cost estimate limit need force=true. A model with no
# price in the catalog is refused (model_not_priced) unless unpriced models are allowed.
# AGENT_RUN_COST_LIMIT_USD=0.50
# AGENT_ALLOW_UNPRICED_MODELS=false
# Browser origins allowed to call the API, and host names the API answers to (JSON lists).
# CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# ALLOWED_HOSTS=["localhost","127.0.0.1"]
