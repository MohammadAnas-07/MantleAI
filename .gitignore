# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/

# Secrets: never commit real env files (.env, .env.production, .env.local, ...), but keep
# the examples (backend/.env.example, frontend/.env.example). The negation must come last.
.env
.env.*
!.env.example

# Database backups (README "Backup and restore")
*.dump

# Node / frontend
node_modules/
dist/
coverage/
*.tsbuildinfo
.env.local
.env.*.local

# Editors
.idea/

# Coverage data (pytest --cov)
.coverage
.coverage.*
htmlcov/
